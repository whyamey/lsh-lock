+# ---------------------------------------------------------------- full-reading NIST diagnostics (once per export)
+# Separate full-reading tests, never folded into the per-subset estimator minimum.
+# FACED matches the existing evaluation configuration; this hook never changes source labels.
+g_nist() {
+  local nist_repo=${NIST_LSH_ROOT:-$(dirname "$(dirname "$(dirname "$LSH")")")}
+  local nist_python=${NIST_PYTHON:-python3}
+  local tag=${NIST_TAG:-full}
+  local attempt name
+  if [[ ! "$tag" =~ ^[a-zA-Z0-9._-]+$ ]]; then
+    echo "NIST_TAG may contain only letters, digits, dots, underscores and hyphens" >&2; exit 1
+  fi
+  if [ "$DRY" != 1 ] && [ ! -f "$nist_repo/scripts/nist_datasets.py" ]; then
+    echo "NIST wrapper missing; set NIST_LSH_ROOT to the reviewed LSH source checkout" >&2; exit 1
+  fi
+  if [ "$DRY" = 1 ]; then
+    name="nist_${tag}_NEW"
+    attempt="$OUT/$name"
+  else
+    # Always assess afresh: the parent's log-name cache does not validate inputs.
+    # Preserve partial results on failure, and allocate a new attempt on retry.
+    while :; do
+      attempt=$(mktemp -d "$OUT/nist_${tag}_XXXXXX") || { echo "Cannot create NIST attempt directory" >&2; exit 1; }
+      name=${attempt##*/}
+      [ ! -e "$OUT/$name.txt" ] && break
+    done
+  fi
+  run "$name" "$nist_python" "$nist_repo/scripts/nist_datasets.py" \
+      --data-root "$D" --face-templates "${NIST_FACE:-$FACED}" \
+      --output-root "$attempt/assessment" --nist-bin "${NIST_EA_NON_IID:-ea_non_iid}" \
+      --trials "${NIST_TRIALS:-1000}" --seed "${NIST_SEED:-67}" \
+      --jobs "${NIST_JOBS:-1}" --timeout "${NIST_TIMEOUT:-180}"
 }
 
